<Window x:Class="GlassLinq.UIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GlassLinq.UIExplorer"
        mc:Ignorable="d"
        Title="UI Explorer" Height="700" Width="1200"
        Background="#1E1E1E">
    


    <Window.Resources>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock Text="{Binding Icon}" 
                       Margin="0,0,5,0" 
                       VerticalAlignment="Center" 
                       FontSize="14"/>
                <TextBlock Text="{Binding DisplayName}" 
                       Foreground="#E0E0E0" 
                       VerticalAlignment="Center" 
                       FontSize="12"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D3D3D" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D2D" />
            </Style.Resources>
        </Style>

        <ControlTemplate x:Key="LoadingSpinner">
            <Grid>
                <TextBlock Text="⟳" FontSize="14" Foreground="#2196F3" 
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="black" Padding="10" CornerRadius="4" 
                BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnValidate" Grid.Column="0" Content="Validate" 
                        Padding="12,6" Margin="0,0,8,0" 
                        Style="{StaticResource DarkButtonStyle}"
                        Background="#333333" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"
                        Click="ValidateSelector_Click"/>

                <Button x:Name="btnIndicateElement" Grid.Column="1" Content="🎯 Indicate Element" 
                        Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource DarkButtonStyle}"
                        Background="#333333" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"
                        Click="IndicateElement_Click"/>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="🔄 Refresh" 
                        Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource DarkButtonStyle}"
                        Background="#333333" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"
                        Click="RefreshTree_Click"/>

                <Button x:Name="btnExpandAll" Grid.Column="3" Content="⊞ Expand All" 
                        Padding="12,6" Margin="0,0,8,0"
                        Style="{StaticResource DarkButtonStyle}"
                        Background="#333333" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"
                        Click="ExpandAll_Click"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,0,8,0">
                    <TextBox x:Name="txtSearch" Width="250" Padding="8,6"
                             Background="#121212"
                             Foreground="White"
                             BorderBrush="#333333" BorderThickness="1"
                             VerticalContentAlignment="Center"
                             TextChanged="Search_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Search elements..." 
                                                                   Foreground="#888888" 
                                                                   Margin="8,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button x:Name="btnClearSearch" Content="✕" 
                            Padding="8,6" Margin="4,0,0,0"
                            Style="{StaticResource DarkButtonStyle}"
                            Background="#333333" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="ClearSearch_Click"/>
                </StackPanel>

                <Button x:Name="btnOptions" Grid.Column="5" Content="⚙ Options" 
                        Padding="12,6"
                        Style="{StaticResource DarkButtonStyle}"
                        Background="#607D8B" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#121212" CornerRadius="4" 
                    BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Black" Padding="10,8">
                        <Grid>
                            <TextBlock Text="Visual Tree" FontWeight="Bold" 
                                       Foreground="#E0E0E0" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Control x:Name="loadingIndicator" 
                                         Template="{StaticResource LoadingSpinner}"
                                         Width="16" Height="16" 
                                         Visibility="Collapsed" Margin="0,0,8,0"/>
                                <TextBlock x:Name="treeStats" Text="0 elements" 
                                           Foreground="#888888" FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView x:Name="AutomationTree" Grid.Row="1"
                              Background="Black"
                              BorderThickness="0"
                              Padding="5"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.CacheLength="20"
                              VirtualizingPanel.CacheLengthUnit="Item"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Foreground="#2196F3"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" 
                                             Foreground="White" FontWeight="SemiBold"/>
                                        <Run Text=" (" Foreground="#757575"/>
                                        <Run Text="{Binding ControlType, Mode=OneWay}" 
                                             Foreground="#757575"/>
                                        <Run Text=")" Foreground="#757575"/>
                                    </TextBlock>
                                    <Control Template="{StaticResource LoadingSpinner}"
                                             Width="12" Height="12" Margin="8,0,0,0"
                                             Visibility="{Binding IsLoading, 
                                                Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" 
                          HorizontalAlignment="Center" 
                          Background="Transparent"
                          ShowsPreview="True"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="150"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#121212" CornerRadius="4" 
                        BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="black" Padding="10,8">
                            <TextBlock Text="Selector Editor" FontWeight="Bold" 
                                       Foreground="#E0E0E0" FontSize="14"/>
                        </Border>

                        <TextBox x:Name="txtFullSelector" Grid.Row="1"
                                 Margin="10" Padding="10"
                                 Background="Black"
                                 Foreground="#569CD6"
                                 BorderThickness="0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontSize="12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                    HorizontalAlignment="Right" Margin="10">
                            <Button Content="📋 Copy" Padding="10,6" Margin="0,0,8,0"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Background="#333333" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="CopySelector_Click"/>
                            <Button Content="✓ Validate" Padding="10,6"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Background="#333333" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" 
                              HorizontalAlignment="Stretch" 
                              Background="Transparent"
                              ShowsPreview="True"/>

                <Border Grid.Row="2" Background="black" CornerRadius="4" 
                        BorderBrush="#333333" BorderThickness="1" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#1E1E1E" Padding="10,8">
                            <TextBlock Text="Property Explorer" FontWeight="Bold" 
                                       Foreground="#E0E0E0" FontSize="14"/>
                        </Border>

                        <DataGrid x:Name="dgProperties" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  Background="Black"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#1A1A1A"
                                  RowBackground="#121212"
                                  Foreground="black">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Property" 
                                                    Binding="{Binding PropertyName}" 
                                                    Width="150"
                                                    FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Value" 
                                                    Binding="{Binding Value}" 
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#263238" Padding="10,6" 
                CornerRadius="4" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="statusText" Text="Ready" 
                           Foreground="White" FontSize="12"/>
                <TextBlock x:Name="performanceText" Text="" 
                           Foreground="#B0BEC5" FontSize="11"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>