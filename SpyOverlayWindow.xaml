<Window x:Class="GlassLinq.UIExplorer.SpyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{x:Null}" 
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">

    <Grid Background="Transparent" IsHitTestVisible="False">
        <Canvas IsHitTestVisible="False" Background="Transparent">
            <!-- Main cyan border with glow effect -->
            <Border x:Name="HighlightBorder" 
                    BorderBrush="#00BCD4" 
                    BorderThickness="3" 
                    Background="#1100BCD4"
                    CornerRadius="2" 
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#00BCD4" 
                                     BlurRadius="12" 
                                     ShadowDepth="0" 
                                     Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Info label showing element name -->
            <Border x:Name="InfoLabel"
                    Background="#00BCD4"
                    CornerRadius="3"
                    Padding="8,4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" 
                                     BlurRadius="8" 
                                     ShadowDepth="2" 
                                     Opacity="0.5"/>
                </Border.Effect>
                <TextBlock x:Name="InfoText" 
                          Foreground="White" 
                          FontSize="11"
                          FontWeight="SemiBold"
                          Text="Element Name"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
